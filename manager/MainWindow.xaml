<Window x:Class="CraneLoader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CraneLoader" Height="620" Width="1000"
        MinHeight="460" MinWidth="760"
        Background="{DynamicResource Surface}"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">

  <!--
    Four horizontal bands and one vertical split: identity and system state,
    actions, body, summary. The split is the only vertical division and
    separates "what do I have" from "what is this one".

    Nothing here is positioned by coordinate.
  -->
  <!--
    Everything scales together from one transform on the root. WPF measures in
    device-independent units, so this is a genuine zoom rather than a font
    change: controls, spacing and text all grow, and nothing overlaps at any
    setting. Persisted, and adjustable from Settings.
  -->
  <DockPanel x:Name="Root">
    <DockPanel.LayoutTransform>
      <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1"/>
    </DockPanel.LayoutTransform>

    <!--
      The window title lives in the OS title bar and nowhere else. It was in both
      places, which is one too many, and the fix is to delete our copy rather
      than the shell's: suppressing the real title bar means reimplementing drag,
      resize, snap, minimise, maximise and the accessibility behaviours that come
      with it, and every one of those is worse hand-rolled.

      The bar follows the theme instead, through DWMWA_USE_IMMERSIVE_DARK_MODE
      in MainWindow.xaml.cs, which the shell applies to its own chrome.

      That leaves this band carrying system state only, so it merges into the
      toolbar row below and buys back its height.
    -->

    <!--
      (10) Summary. Quiet, and using the same state vocabulary as the capsule.
    -->
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceAlt}"
            BorderBrush="{DynamicResource Rule}" BorderThickness="0,1,0,0"
            Padding="{StaticResource PadStatus}">
      <Grid>
        <TextBlock x:Name="StatusText" Text="STARTING" Style="{StaticResource TaxonomyLabel}"/>
        <TextBlock x:Name="StatusRight" Style="{StaticResource TaxonomyLabel}"
                   HorizontalAlignment="Right" Foreground="{DynamicResource InkFaint}"/>
      </Grid>
    </Border>

    <!-- (2) Actions, placed by scope: global left, configuration right. -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource SurfaceAlt}"
            BorderBrush="{DynamicResource Rule}"
            BorderThickness="0,0,0,1" Padding="{StaticResource PadBand}">
      <Grid>
        <!-- No wordmark and no icon: Windows already draws both in the title
             bar, and repeating them spends the toolbar row saying it twice. -->
        <StackPanel Orientation="Horizontal">
          <Button x:Name="AddButton" Click="OnAdd">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Add script" Margin="8,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>

          <Button x:Name="ReloadButton" Margin="8,0,0,0" Click="OnReload">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE72C;"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Reload" Margin="8,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>

          <Button x:Name="LaunchButton" Content="Launch game" Margin="8,0,0,0"
                  Style="{StaticResource PrimaryButton}" Click="OnLaunch"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <!-- A compact capsule, so the readout reads as instrumentation. -->
          <Border x:Name="ConnectionCapsule" CornerRadius="{StaticResource RadiusButton}"
                  Background="{DynamicResource Surface}"
                  BorderBrush="{DynamicResource Rule}" BorderThickness="1"
                  Padding="9,4,11,4" VerticalAlignment="Center" Margin="0,0,12,0">
            <StackPanel Orientation="Horizontal">
              <Ellipse x:Name="ConnectionDot" Width="8" Height="8"
                       Fill="{DynamicResource StateIdle}" VerticalAlignment="Center"/>
              <TextBlock x:Name="ConnectionText" Text="GAME OFFLINE" Margin="8,0,0,0"
                         Style="{StaticResource TaxonomyLabel}"/>
            </StackPanel>
          </Border>

          <Button x:Name="SettingsButton" Click="OnSettings">
            <StackPanel Orientation="Horizontal">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
              <TextBlock Text="Settings" Margin="8,0,0,0" VerticalAlignment="Center"
                         Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </StackPanel>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body -->
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="240"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*" MinWidth="320"/>
      </Grid.ColumnDefinitions>

      <!--
        Two lists, one column. Scripts are things the user added and can delete;
        Bridge clients are installed mods whose settings this tool can reach.
        They are separated rather than merged because the two carry different
        promises: unticking a script stops it entirely, while unticking a client
        only sets its own Enabled key and only if it declared one.

        The splitter gives scripts the flexible half and clients a proportional
        one, so a long client list cannot squeeze the scripts to nothing.
      -->
      <Border Grid.Column="0" Background="{DynamicResource SurfaceAlt}">
      <Grid>
        <!--
          Clients above scripts, and clients sized to their content.

          Installed mods are a fixed set the user did not choose the length of,
          so the list should be exactly as tall as it needs to be; scripts are
          open-ended and get the elastic remainder. Proportional rows made a
          two-client list sit in a half-empty panel while the scripts below it
          scrolled.

          MaxHeight caps the growth so a folder full of annotated mods cannot
          squeeze the scripts list to nothing. Past the cap the client list
          scrolls internally, which is the right failure.
        -->
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="Auto" MaxHeight="360"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*" MinHeight="90"/>
        </Grid.RowDefinitions>

        <!-- Label plus a short accent rule, rather than a filled block
             header. -->
        <StackPanel Grid.Row="0" Margin="12,12,12,6">
          <TextBlock Text="BRIDGE CLIENTS" Style="{StaticResource TaxonomyLabel}"/>
          <Border Height="2" Width="26" HorizontalAlignment="Left"
                  Background="{DynamicResource Accent}" Margin="0,5,0,0"/>
        </StackPanel>

      <DockPanel Grid.Row="3">
        <StackPanel DockPanel.Dock="Top" Margin="12,14,12,6">
          <TextBlock Text="CRANE SCRIPTS" Style="{StaticResource TaxonomyLabel}"/>
          <Border Height="2" Width="26" HorizontalAlignment="Left"
                  Background="{DynamicResource Accent}" Margin="0,5,0,0"/>
        </StackPanel>
        <ListBox x:Name="ScriptList"
                 SelectionChanged="OnScriptSelected"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemContainerStyle>
            <!-- BasedOn matters: an ItemContainerStyle without it replaces the
                 implicit ListBoxItem style, losing the selection strip. -->
            <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate>
              <!-- Two lines. Control and name on the first, adaptive secondary
                   text indented beneath. The state dot is flush right so the
                   eye can scan either edge independently: all the checkboxes,
                   or all the dots. -->
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <CheckBox Grid.Column="0" Grid.Row="0" VerticalAlignment="Center"
                          IsChecked="{Binding Enabled, Mode=TwoWay}"/>
                <TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Name}"
                           Margin="8,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"/>
                <!-- Two dots, not one. The right-hand dot is what the runtime
                     reported; this amber one is a lease this script will be
                     refused, worked out from the manifest without the game
                     running. A script can be Loaded and refused at the same
                     time, so neither dot can stand in for the other. -->
                <StackPanel Grid.Column="2" Grid.Row="0" Orientation="Horizontal"
                            VerticalAlignment="Center">
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Margin="8,0,0,0"
                           Fill="{DynamicResource StateWarn}"
                           ToolTip="{Binding ConflictTip}"
                           Visibility="{Binding HasConflict, Converter={StaticResource ShowIf}}"/>
                  <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                           Margin="8,0,2,0"
                           Fill="{Binding StateBrush, Converter={StaticResource BrushLookup}}"
                           Visibility="{Binding HasDot, Converter={StaticResource ShowIf}}"/>
                </StackPanel>

                <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="2"
                           Text="{Binding Secondary}" Margin="8,1,0,0"
                           FontSize="11" Foreground="{DynamicResource InkMuted}"
                           TextTrimming="CharacterEllipsis"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <ListBox x:Name="ClientList" Grid.Row="1"
               SelectionChanged="OnClientSelected"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemContainerStyle>
          <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"/>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
          <DataTemplate>
            <!-- Same two-line shape as a script row, so the eye reads one list
                 idiom rather than two. When the client declares no enable key
                 the checkbox is absent rather than disabled: a control that
                 cannot do anything still looks like a control. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
              </Grid.RowDefinitions>

              <!--
                No checkbox here.

                A client's enable key is just one of its INI values, and for
                Beastly Hunger its own comment reads "Restart required after
                changing this". Rendering it as a checkbox identical to the
                script checkboxes above promised the same immediacy those have,
                which it cannot deliver. It now appears in the detail pane with
                the rest of the settings, where the caveat can be stated.

                The row still says "Off" on its second line, so the list keeps
                the information without offering an action it cannot honour.
              -->
              <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="0"
                         Text="{Binding Name}" VerticalAlignment="Center"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1"
                         Text="{Binding Secondary}" Margin="0,1,0,0" FontSize="11"
                         Foreground="{DynamicResource InkMuted}"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>

      </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="1" HorizontalAlignment="Stretch"
                    Background="{DynamicResource Rule}" ResizeBehavior="PreviousAndNext"/>

      <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto"
                    Padding="{StaticResource PadPane}">
        <StackPanel x:Name="Detail"/>
      </ScrollViewer>
    </Grid>

  </DockPanel>
</Window>
