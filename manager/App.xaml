<Application x:Class="CraneLoader.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:CraneLoader">
  <!-- No StartupUri. App.OnStartup decides which window to open, because the
       selftest switch has to construct MainWindow without showing it. -->
  <Application.Resources>

    <local:BrushLookupConverter x:Key="BrushLookup"/>
    <local:ShowIfConverter x:Key="ShowIf"/>

    <!--
      One place for spacing, colour and type. Every dimension below is in
      device-independent units, which WPF scales, so this port needs no DPI
      manifest and produces no soft text.

      Everything is in this one dictionary rather than a merged Theme.xaml,
      because merged dictionaries resolve through pack URIs at runtime and a
      pack URI failure is a launch failure. See the icon note in
      CraneLoader.csproj.
    -->

    <system:Double x:Key="GapTight">4</system:Double>
    <system:Double x:Key="Gap">8</system:Double>
    <system:Double x:Key="GapWide">16</system:Double>

    <!-- Spacing as Thickness, so XAML can bind padding to the scale rather than
         hand-typing it. The doubles above stayed for code-behind callers. -->
    <Thickness x:Key="PadButton">12,5,12,5</Thickness>
    <Thickness x:Key="PadBand">16,8,16,8</Thickness>
    <Thickness x:Key="PadRow">10,7,10,7</Thickness>
    <Thickness x:Key="PadPane">16,12,16,12</Thickness>
    <Thickness x:Key="PadStatus">16,6,16,6</Thickness>

    <!-- Corners stay tight. 3px on buttons, 2px on inputs, square on rows: the
         tool should read as engineered rather than as a consumer app. -->
    <CornerRadius x:Key="RadiusButton">3</CornerRadius>
    <CornerRadius x:Key="RadiusInput">2</CornerRadius>

    <!--
      Type. Segoe UI Variable Text is Windows 11 only, so the stack falls back
      through Segoe UI, which every supported Windows has. Bahnschrift ships with
      Windows 10 and later and is used only for section headings and the small
      taxonomy labels: enough mechanical character to place the tool, not enough
      to cost readability.
    -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI, Tahoma</FontFamily>
    <FontFamily x:Key="DisplayFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI Semibold, Segoe UI</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!--
      Default values only. Theme.cs owns the palettes and overwrites every
      brush below at startup, so editing a colour here changes the first frame
      and nothing after it. Change it in Theme.cs.

      These brushes must stay unfrozen, because switching themes mutates each
      one's Color in place. Declaring PresentationOptions:Freeze on any of them
      would stop theme switching without any error.

      Three text levels, measured against Surface rather than judged by eye:
      primary 13.43:1, secondary 6.92:1, disabled 3.74:1. Disabled has to read as
      dimmer than a description, or the two blur once real disabled states
      exist.
    -->
    <SolidColorBrush x:Key="Ink"           Color="#ECEBE7"/>
    <SolidColorBrush x:Key="InkMuted"      Color="#A7ABAC"/>
    <SolidColorBrush x:Key="InkFaint"      Color="#767B7E"/>
    <SolidColorBrush x:Key="Rule"          Color="#3D444A"/>
    <SolidColorBrush x:Key="RuleStrong"    Color="#565E64"/>
    <SolidColorBrush x:Key="Surface"       Color="#1E2225"/>
    <SolidColorBrush x:Key="SurfaceAlt"    Color="#252A2E"/>
    <SolidColorBrush x:Key="SurfaceRaised" Color="#2E3438"/>
    <SolidColorBrush x:Key="SurfaceHover"  Color="#373E42"/>
    <SolidColorBrush x:Key="SurfacePress"  Color="#23282B"/>
    <SolidColorBrush x:Key="SurfaceInput"  Color="#191D20"/>
    <!-- Ground for a failure block. Its text is Ink rather than StateBad, which
         barely clears 4.5:1 here; the rust goes on the edge bar instead. -->
    <SolidColorBrush x:Key="SurfaceAlert"  Color="#2E211D"/>

    <SolidColorBrush x:Key="Accent"        Color="#7FBAC8"/>
    <SolidColorBrush x:Key="AccentDim"     Color="#3E5A63"/>
    <SolidColorBrush x:Key="AccentWarm"    Color="#D2B36C"/>
    <SolidColorBrush x:Key="AccentWarmDim" Color="#6A5A36"/>
    <!-- Text drawn on an accent fill: the primary button and the checkbox
         tick. A theme value, not a constant. -->
    <SolidColorBrush x:Key="OnAccent"      Color="#1E2225"/>

    <!--
      Few state colours on purpose: a status vocabulary with eight shades
      communicates less than one with three.

      StateBad has needed re-measuring twice as the surfaces moved; at #CB7360 it
      clears 4.5:1 for small text. Re-measure it whenever Surface changes.

      These four keys are looked up by name at runtime by BrushLookupConverter,
      so a row binds its state colour without constructing brushes in code.
      Renaming one makes the row dots transparent.
    -->
    <SolidColorBrush x:Key="StateGood"  Color="#7FBAC8"/>
    <SolidColorBrush x:Key="StateWarn"  Color="#D2B36C"/>
    <SolidColorBrush x:Key="StateBad"   Color="#CB7360"/>
    <SolidColorBrush x:Key="StateIdle"  Color="#767B7E"/>

    <!-- ================================================================== -->
    <!-- Text                                                                -->
    <!-- ================================================================== -->

    <!-- Implicit, so TextBlocks built in code-behind are legible without
         touching each call site. A keyed style does not inherit this one, so
         each sets its own colour.

         No TextFormattingMode here: TextOptions inherits, and the root sets it
         from the UI scale in ApplyScale. -->
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
    </Style>

    <Style x:Key="Title" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontSize" Value="17"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <Style x:Key="Subtle" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>

    <Style x:Key="SectionHeading" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource AccentWarm}"/>
      <Setter Property="Margin" Value="0,16,0,6"/>
    </Style>

    <!-- Taxonomy labels: small, semibold, tracked out, quiet. -->
    <Style x:Key="TaxonomyLabel" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource DisplayFont}"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{DynamicResource InkMuted}"/>
    </Style>


    <!-- ================================================================== -->
    <!-- Buttons                                                             -->
    <!-- ================================================================== -->

    <!--
      A full ControlTemplate rather than setters, because the stock WPF button on
      .NET Framework draws through ButtonChrome and ignores Background.
    -->
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceRaised}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="{StaticResource PadButton}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Chrome"
                    CornerRadius="{StaticResource RadiusButton}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfacePress}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceAlt}"/>
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Rule}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- One accented button in the window, so the primary action is obvious. -->
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
      <Setter Property="Background" Value="{DynamicResource AccentWarm}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource AccentWarm}"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <!-- ================================================================== -->
    <!-- CheckBox                                                            -->
    <!-- ================================================================== -->

    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel Orientation="Horizontal" Background="Transparent">
              <Border x:Name="Box" Width="18" Height="18"
                      CornerRadius="{StaticResource RadiusInput}"
                      Background="{DynamicResource SurfaceInput}"
                      BorderBrush="{DynamicResource RuleStrong}"
                      BorderThickness="1"
                      SnapsToDevicePixels="True"
                      VerticalAlignment="Center">
                <TextBlock x:Name="Tick" Text="&#xE73E;" Opacity="0"
                           FontFamily="{StaticResource IconFont}" FontSize="12"
                           Foreground="{DynamicResource OnAccent}"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           TextOptions.TextFormattingMode="Ideal"/>
              </Border>
              <ContentPresenter Margin="8,0,0,0" VerticalAlignment="Center"
                                RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                <Setter TargetName="Tick" Property="Opacity" Value="1"/>
              </Trigger>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
                <Setter TargetName="Box" Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- TextBox                                                             -->
    <!-- ================================================================== -->

    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="Background" Value="{DynamicResource SurfaceInput}"/>
      <Setter Property="BorderBrush" Value="{DynamicResource Rule}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="7,4,7,4"/>
      <Setter Property="CaretBrush" Value="{DynamicResource Accent}"/>
      <Setter Property="SelectionBrush" Value="{DynamicResource AccentDim}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Chrome"
                    CornerRadius="{StaticResource RadiusInput}"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    SnapsToDevicePixels="True">
              <ScrollViewer x:Name="PART_ContentHost"
                            Margin="{TemplateBinding Padding}"
                            VerticalAlignment="Center"
                            Focusable="False"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Hidden"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
              </Trigger>
              <!-- Replaces the system focus rectangle. -->
              <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- ComboBox                                                            -->
    <!-- ================================================================== -->

    <Style x:Key="ComboToggle" TargetType="ToggleButton">
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="ClickMode" Value="Press"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome"
                    CornerRadius="{StaticResource RadiusInput}"
                    Background="{DynamicResource SurfaceInput}"
                    BorderBrush="{DynamicResource Rule}"
                    BorderThickness="1"
                    SnapsToDevicePixels="True">
              <TextBlock x:Name="Arrow" Text="&#xE70D;"
                         HorizontalAlignment="Right" VerticalAlignment="Center"
                         Margin="0,0,9,0"
                         FontFamily="{StaticResource IconFont}" FontSize="10"
                         Foreground="{DynamicResource InkMuted}"
                         TextOptions.TextFormattingMode="Ideal"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource RuleStrong}"/>
                <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Ink}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Padding" Value="9,5,9,5"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome" Background="Transparent" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentDim}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ComboBox">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Padding" Value="8,4,26,4"/>
      <Setter Property="MinHeight" Value="26"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ComboBox">
            <Grid>
              <ToggleButton Style="{StaticResource ComboToggle}"
                            IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                        RelativeSource={RelativeSource TemplatedParent}}"/>
              <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False"/>
              <Popup x:Name="PART_Popup" AllowsTransparency="True"
                     Placement="Bottom"
                     IsOpen="{TemplateBinding IsDropDownOpen}"
                     Focusable="False"
                     PopupAnimation="None">
                <Border Background="{DynamicResource SurfaceRaised}"
                        BorderBrush="{DynamicResource RuleStrong}"
                        BorderThickness="1"
                        MinWidth="{TemplateBinding ActualWidth}"
                        MaxHeight="{TemplateBinding MaxDropDownHeight}"
                        SnapsToDevicePixels="True">
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsPresenter/>
                  </ScrollViewer>
                </Border>
              </Popup>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource InkFaint}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- ================================================================== -->
    <!-- List rows                                                           -->
    <!-- ================================================================== -->

    <!-- A raised row plus an accent strip on the leading edge, rather than the
         system's selection rectangle, so the row's state dot stays the only
         saturated colour in it. -->
    <Style TargetType="ListBoxItem">
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
      <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
      <Setter Property="Padding" Value="{StaticResource PadRow}"/>
      <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Grid Background="Transparent">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <Border x:Name="Strip" Grid.Column="0" Background="Transparent"/>
              <Border x:Name="Chrome" Grid.Column="1" Background="Transparent"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceHover}"/>
              </Trigger>
              <Trigger Property="IsSelected" Value="True">
                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource SurfaceRaised}"/>
                <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Accent}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ListBox">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
    </Style>

    <!-- ================================================================== -->
    <!-- ScrollBar                                                           -->
    <!-- ================================================================== -->

    <!-- A narrow track with a grey thumb, so it recedes until needed. -->
    <Style x:Key="ScrollThumb" TargetType="Thumb">
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="Bar" CornerRadius="{StaticResource RadiusInput}"
                    Background="{DynamicResource RuleStrong}"
                    Margin="3" SnapsToDevicePixels="True"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InkFaint}"/>
              </Trigger>
              <Trigger Property="IsDragging" Value="True">
                <Setter TargetName="Bar" Property="Background" Value="{DynamicResource InkMuted}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- The line-up/line-down arrows are removed rather than restyled. -->
    <Style x:Key="ScrollNoArrow" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Opacity" Value="0"/>
      <Setter Property="Height" Value="0"/>
      <Setter Property="Width" Value="0"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="ScrollPage" TargetType="RepeatButton">
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ScrollBar">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Width" Value="11"/>
      <Setter Property="SnapsToDevicePixels" Value="True"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Border Background="{TemplateBinding Background}">
              <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageUpCommand"/>
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                  <Thumb Style="{StaticResource ScrollThumb}"/>
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageDownCommand"/>
                </Track.IncreaseRepeatButton>
              </Track>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="Height" Value="11"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Border Background="{TemplateBinding Background}">
                  <Track x:Name="PART_Track" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageLeftCommand"/>
                    </Track.DecreaseRepeatButton>
                    <Track.Thumb>
                      <Thumb Style="{StaticResource ScrollThumb}"/>
                    </Track.Thumb>
                    <Track.IncreaseRepeatButton>
                      <RepeatButton Style="{StaticResource ScrollPage}" Command="ScrollBar.PageRightCommand"/>
                    </Track.IncreaseRepeatButton>
                  </Track>
                </Border>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>

    <!-- ================================================================== -->
    <!-- Icons                                                               -->
    <!-- ================================================================== -->

    <!--
      Icons come from Windows' own icon font rather than from geometry authored
      here, so they stay smooth at every UI scale.

      Segoe Fluent Icons is Windows 11; Segoe MDL2 Assets is Windows 10 and
      later and uses the same code points, so the fallback is the same icon.
    -->

    <Style x:Key="Glyph" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource IconFont}"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

  </Application.Resources>
</Application>
